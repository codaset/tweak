{
  "manifest_version": 3,
  "name": "Codaset Tweak",
  "version": "0.1.0",
  "description": "Point at any element on your dev server, describe a tweak, and the Claude Code session that claimed the page makes the change.",
  "minimum_chrome_version": "116",
  "key": "",
  "permissions": ["activeTab", "alarms", "contextMenus", "scripting", "sidePanel", "storage"],
  "optional_host_permissions": ["<all_urls>"],
  "background": { "service_worker": "worker.js", "type": "module" },
  "action": { "default_title": "Codaset Tweak" },
  "side_panel": { "default_path": "panel/panel.html" },
  "commands": {
    "pick-mode": { "suggested_key": { "default": "Alt+Shift+C" }, "description": "Pick an element to tweak" },
    "side-panel": { "suggested_key": { "default": "Alt+Shift+N" }, "description": "Open the side panel" },
    "pins": { "suggested_key": { "default": "Alt+Shift+H" }, "description": "Hide or show this site's pins" }
  }
}
