{
  "name": "codaset-tweak-dev",
  "private": true,
  "description": "Development only: the extension's tests and the e2e suite. The shipped extension has no dependencies.",
  "type": "module",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "test": "node --test \"test/extension/**/*.test.js\" \"test/scripts/**/*.test.js\" \"test/e2e/harness/**/*.test.js\"",
    "e2e": "go build -o node_modules/.cache/codaset-tweak-e2e/tweak ./cmd/tweak && node --test \"test/e2e/*.test.js\"",
    "check:consistency": "node scripts/check-consistency.js"
  },
  "devDependencies": {
    "ajv": "8.20.0",
    "puppeteer": "25.19.0"
  }
}
