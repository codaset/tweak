{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/codaset/tweak/schema/claim.json",
  "title": "claim",
  "description": "The reply to POST /claims: the claim made, or the session's existing claim on the same pattern, with any warnings for tweak claim to print.",
  "type": "object",
  "properties": {
    "id": {
      "$ref": "#/$defs/claim/properties/id"
    },
    "pattern": {
      "$ref": "#/$defs/claim/properties/pattern"
    },
    "session": {
      "$ref": "#/$defs/claim/properties/session"
    },
    "created": {
      "$ref": "#/$defs/claim/properties/created"
    },
    "warnings": {
      "description": "Lines tweak claim prints after claiming, for example that Chrome loads the extension from another folder. Absent when there are none.",
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1
    }
  },
  "required": [
    "id",
    "pattern",
    "session",
    "created"
  ],
  "additionalProperties": false,
  "$defs": {
    "claim": {
      "description": "A claim: a session's ownership of the pages matching a pattern.",
      "type": "object",
      "properties": {
        "id": {
          "type": "integer",
          "minimum": 1
        },
        "pattern": {
          "description": "The normalised Chrome match pattern, as the extension registers it.",
          "type": "string",
          "minLength": 1
        },
        "session": {
          "$ref": "#/$defs/session"
        },
        "created": {
          "type": "string",
          "description": "RFC 3339",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T"
        }
      },
      "required": [
        "id",
        "pattern",
        "session",
        "created"
      ],
      "additionalProperties": false
    },
    "session": {
      "description": "A session: one agent conversation.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "agent": {
          "type": "string",
          "minLength": 1
        },
        "folder": {
          "type": "string",
          "minLength": 1
        },
        "label": {
          "type": "string"
        },
        "lastCheckIn": {
          "type": "string",
          "description": "RFC 3339",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T"
        }
      },
      "required": [
        "id",
        "agent",
        "folder",
        "label",
        "lastCheckIn"
      ],
      "additionalProperties": false
    }
  }
}
