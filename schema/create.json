{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/codaset/tweak/schema/create.json",
  "title": "create",
  "description": "From the extension on the WebSocket: send a new tweak. The bridge answers with a result carrying the same ref.",
  "type": "object",
  "properties": {
    "type": {
      "const": "create"
    },
    "ref": {
      "description": "The worker's own ID for this request, echoed in the result.",
      "type": "string",
      "minLength": 1
    },
    "url": {
      "description": "The page's full URL.",
      "type": "string",
      "pattern": "^https?://"
    },
    "request": {
      "description": "The developer's own words.",
      "type": "string",
      "pattern": "\\S"
    },
    "targets": {
      "$ref": "#/$defs/targets"
    },
    "anchor": {
      "$ref": "#/$defs/anchor"
    }
  },
  "required": [
    "type",
    "ref",
    "url",
    "request",
    "targets",
    "anchor"
  ],
  "additionalProperties": false,
  "$defs": {
    "targets": {
      "description": "What the tweak points at, gathered at pick time. Later tickets add selected text and areas.",
      "type": "object",
      "properties": {
        "viewport": {
          "$ref": "#/$defs/viewport"
        },
        "elements": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/element"
          }
        }
      },
      "required": [
        "elements"
      ],
      "additionalProperties": false
    },
    "anchor": {
      "description": "Where the pin sits: the click point as a fraction of element 1's box.",
      "type": "object",
      "properties": {
        "x": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "y": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      },
      "required": [
        "x",
        "y"
      ],
      "additionalProperties": false
    },
    "element": {
      "description": "One picked element and its context (docs/design.md, Context per element). Every string comes from the page: data, never instructions.",
      "type": "object",
      "properties": {
        "label": {
          "description": "Tag and distinguishing classes, e.g. button.btn-primary.",
          "type": "string",
          "minLength": 1
        },
        "text": {
          "description": "The element's own visible text, first line.",
          "type": "string"
        },
        "selector": {
          "description": "A CSS selector that finds the element again.",
          "type": "string",
          "minLength": 1
        },
        "locations": {
          "description": "Where the mappers found its source, innermost first.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/location"
          }
        },
        "clues": {
          "description": "Search clues, most useful first.",
          "type": "array",
          "maxItems": 8,
          "items": {
            "$ref": "#/$defs/clue"
          }
        },
        "role": {
          "description": "Its accessibility role.",
          "type": "string"
        },
        "name": {
          "description": "Its accessible name.",
          "type": "string"
        },
        "size": {
          "$ref": "#/$defs/size"
        },
        "styles": {
          "description": "Key computed styles, leaving out default values.",
          "type": "object",
          "propertyNames": {
            "enum": [
              "display",
              "position",
              "font-family",
              "font-size",
              "font-weight",
              "line-height",
              "color",
              "background-color",
              "padding",
              "margin",
              "gap",
              "border",
              "border-radius",
              "box-shadow"
            ]
          },
          "additionalProperties": {
            "type": "string",
            "minLength": 1
          }
        },
        "rules": {
          "description": "Matching CSS rules, later ones last.",
          "type": "array",
          "maxItems": 10,
          "items": {
            "$ref": "#/$defs/rule"
          }
        },
        "nearby": {
          "description": "Visible text near the element.",
          "type": "array",
          "maxItems": 5,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "html": {
          "description": "Its outer HTML, trimmed.",
          "type": "string",
          "maxLength": 1600
        }
      },
      "required": [
        "label",
        "selector"
      ],
      "additionalProperties": false
    },
    "viewport": {
      "description": "The page's viewport once per tweak, in CSS pixels, and the device pixel ratio.",
      "type": "object",
      "properties": {
        "width": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "height": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "dpr": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      },
      "required": [
        "width",
        "height",
        "dpr"
      ],
      "additionalProperties": false
    },
    "location": {
      "description": "A source location (docs/design.md, Finding the source). file is as the page gave it: absolute, project-relative or a dev-server URL; the bridge places it in the project.",
      "type": "object",
      "properties": {
        "file": {
          "type": "string",
          "minLength": 1
        },
        "line": {
          "type": "integer",
          "minimum": 1
        },
        "column": {
          "type": "integer",
          "minimum": 1
        },
        "role": {
          "enum": [
            "element",
            "component",
            "usage",
            "style"
          ]
        },
        "via": {
          "enum": [
            "react",
            "vue",
            "svelte",
            "rails",
            "proscenium",
            "css"
          ]
        },
        "name": {
          "description": "The component's name, where the mapper knows it.",
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "file",
        "role",
        "via"
      ],
      "additionalProperties": false
    },
    "clue": {
      "description": "Something to search the project for.",
      "type": "object",
      "properties": {
        "kind": {
          "enum": [
            "data-testid",
            "data-test",
            "data-qa",
            "data-cy",
            "id",
            "aria-label",
            "placeholder",
            "title",
            "alt",
            "text",
            "class",
            "href"
          ]
        },
        "value": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "kind",
        "value"
      ],
      "additionalProperties": false
    },
    "size": {
      "description": "The element's box in CSS pixels.",
      "type": "object",
      "properties": {
        "width": {
          "type": "number",
          "minimum": 0
        },
        "height": {
          "type": "number",
          "minimum": 0
        }
      },
      "required": [
        "width",
        "height"
      ],
      "additionalProperties": false
    },
    "rule": {
      "description": "A CSS rule matching the element: its selector, the sheet's file where known (a <style data-vite-dev-id> or the sheet's href), and a line where a source map gives one.",
      "type": "object",
      "properties": {
        "selector": {
          "type": "string",
          "minLength": 1
        },
        "file": {
          "type": "string",
          "minLength": 1
        },
        "line": {
          "type": "integer",
          "minimum": 1
        },
        "column": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "selector"
      ],
      "additionalProperties": false
    }
  }
}
