{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/codaset/tweak/schema/error.json",
  "title": "error",
  "description": "Every refusal from the bridge's HTTP API. message is one line for the CLI to print as-is.",
  "type": "object",
  "properties": {
    "error": {
      "enum": [
        "forbidden",
        "protocol",
        "bad-request",
        "no-session-id",
        "no-session",
        "bad-pattern",
        "overlap",
        "not-claimed",
        "not-found",
        "no-tweak",
        "not-yours",
        "claim-lost",
        "wrong-status",
        "not-undoable",
        "not-undo-requested",
        "still-capturing",
        "too-large",
        "internal"
      ]
    },
    "message": {
      "type": "string",
      "minLength": 1
    },
    "holder": {
      "description": "With overlap: the claim in the way.",
      "$ref": "#/$defs/claim"
    }
  },
  "required": [
    "error",
    "message"
  ],
  "additionalProperties": false,
  "$defs": {
    "claim": {
      "description": "A claim: a session's ownership of the pages matching a pattern.",
      "type": "object",
      "properties": {
        "id": {
          "type": "integer",
          "minimum": 1
        },
        "pattern": {
          "description": "The normalised Chrome match pattern, as the extension registers it.",
          "type": "string",
          "minLength": 1
        },
        "session": {
          "$ref": "#/$defs/session"
        },
        "created": {
          "type": "string",
          "description": "RFC 3339",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T"
        }
      },
      "required": [
        "id",
        "pattern",
        "session",
        "created"
      ],
      "additionalProperties": false
    },
    "session": {
      "description": "A session: one agent conversation.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "agent": {
          "type": "string",
          "minLength": 1
        },
        "folder": {
          "type": "string",
          "minLength": 1
        },
        "label": {
          "type": "string"
        },
        "lastCheckIn": {
          "type": "string",
          "description": "RFC 3339",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T"
        }
      },
      "required": [
        "id",
        "agent",
        "folder",
        "label",
        "lastCheckIn"
      ],
      "additionalProperties": false
    }
  }
}
