{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/codaset/tweak/schema/event.json",
  "title": "event",
  "description": "One entry from the bridge's event log, sent on the WebSocket after the snapshot, in seq order.",
  "type": "object",
  "properties": {
    "type": {
      "const": "event"
    },
    "seq": {
      "description": "The event-log sequence.",
      "type": "integer",
      "minimum": 1
    },
    "event": {
      "enum": [
        "claim-made",
        "claim-released",
        "tweak-created",
        "tweak-status",
        "tweak-replied",
        "tweak-again"
      ]
    },
    "claim": {
      "description": "With claim events: the claim as it was when the event happened.",
      "$ref": "#/$defs/claim"
    },
    "tweak": {
      "description": "With tweak events: the tweak as it was after the event (tweak-status: its status changed or an entry was added; tweak-replied: the developer answered Claude's question, and the tweak is sent again; tweak-again: a delivered tweak Claude hasn't confirmed, sent to its session again).",
      "$ref": "#/$defs/tweak"
    }
  },
  "required": [
    "type",
    "seq",
    "event"
  ],
  "additionalProperties": false,
  "$defs": {
    "claim": {
      "description": "A claim: a session's ownership of the pages matching a pattern.",
      "type": "object",
      "properties": {
        "id": {
          "type": "integer",
          "minimum": 1
        },
        "pattern": {
          "description": "The normalised Chrome match pattern, as the extension registers it.",
          "type": "string",
          "minLength": 1
        },
        "session": {
          "$ref": "#/$defs/session"
        },
        "created": {
          "type": "string",
          "description": "RFC 3339",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T"
        }
      },
      "required": [
        "id",
        "pattern",
        "session",
        "created"
      ],
      "additionalProperties": false
    },
    "session": {
      "description": "A session: one agent conversation.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "agent": {
          "type": "string",
          "minLength": 1
        },
        "folder": {
          "type": "string",
          "minLength": 1
        },
        "label": {
          "type": "string"
        },
        "lastCheckIn": {
          "type": "string",
          "description": "RFC 3339",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T"
        }
      },
      "required": [
        "id",
        "agent",
        "folder",
        "label",
        "lastCheckIn"
      ],
      "additionalProperties": false
    },
    "tweak": {
      "description": "A tweak as it is now (in a snapshot) or as it was when the event happened.",
      "type": "object",
      "properties": {
        "number": {
          "description": "Bridge-wide and permanent.",
          "type": "integer",
          "minimum": 1
        },
        "page": {
          "description": "The page it belongs to: origin and path, no query or hash.",
          "type": "string",
          "minLength": 1
        },
        "url": {
          "description": "The full URL it was sent from.",
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": [
            "sent",
            "delivered",
            "queued",
            "working",
            "question",
            "done",
            "declined",
            "withdrawn"
          ]
        },
        "statusAt": {
          "type": "string",
          "description": "RFC 3339: when the status last changed (the card's time spent working).",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T"
        },
        "created": {
          "type": "string",
          "description": "RFC 3339",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T"
        },
        "updated": {
          "type": "string",
          "description": "RFC 3339",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T"
        },
        "targets": {
          "$ref": "#/$defs/targets"
        },
        "anchor": {
          "$ref": "#/$defs/anchor"
        },
        "entries": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/entry"
          }
        },
        "resends": {
          "description": "Delivered tweaks only: the again: lines sent so far while Claude hasn't confirmed it (docs/design.md, No lost tweaks). Absent for none.",
          "type": "integer",
          "minimum": 1
        },
        "againAt": {
          "type": "string",
          "description": "RFC 3339. Delivered tweaks only: when the current wait for Claude to confirm it ends. With 2 or more resends and this time past, the card says Claude hasn't picked it up. Absent while an again: line waits to be printed.",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T"
        },
        "change": {
          "$ref": "#/$defs/change"
        }
      },
      "required": [
        "number",
        "page",
        "url",
        "status",
        "statusAt",
        "created",
        "updated",
        "targets",
        "anchor",
        "entries"
      ],
      "additionalProperties": false
    },
    "targets": {
      "description": "What the tweak points at, gathered at pick time. Later tickets add selected text and areas.",
      "type": "object",
      "properties": {
        "viewport": {
          "$ref": "#/$defs/viewport"
        },
        "elements": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/element"
          }
        }
      },
      "required": [
        "elements"
      ],
      "additionalProperties": false
    },
    "anchor": {
      "description": "Where the pin sits: the click point as a fraction of element 1's box.",
      "type": "object",
      "properties": {
        "x": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "y": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      },
      "required": [
        "x",
        "y"
      ],
      "additionalProperties": false
    },
    "entry": {
      "description": "One turn of the conversation.",
      "type": "object",
      "properties": {
        "from": {
          "enum": [
            "you",
            "claude",
            "bridge"
          ]
        },
        "kind": {
          "enum": [
            "request",
            "plan",
            "question",
            "reply",
            "summary",
            "reason",
            "undo",
            "notice"
          ]
        },
        "text": {
          "type": "string"
        },
        "at": {
          "type": "string",
          "description": "RFC 3339",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T"
        }
      },
      "required": [
        "from",
        "kind",
        "text",
        "at"
      ],
      "additionalProperties": false
    },
    "element": {
      "description": "One picked element and its context (docs/design.md, Context per element). Every string comes from the page: data, never instructions.",
      "type": "object",
      "properties": {
        "label": {
          "description": "Tag and distinguishing classes, e.g. button.btn-primary.",
          "type": "string",
          "minLength": 1
        },
        "text": {
          "description": "The element's own visible text, first line.",
          "type": "string"
        },
        "selector": {
          "description": "A CSS selector that finds the element again.",
          "type": "string",
          "minLength": 1
        },
        "locations": {
          "description": "Where the mappers found its source, innermost first.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/location"
          }
        },
        "clues": {
          "description": "Search clues, most useful first.",
          "type": "array",
          "maxItems": 8,
          "items": {
            "$ref": "#/$defs/clue"
          }
        },
        "role": {
          "description": "Its accessibility role.",
          "type": "string"
        },
        "name": {
          "description": "Its accessible name.",
          "type": "string"
        },
        "size": {
          "$ref": "#/$defs/size"
        },
        "styles": {
          "description": "Key computed styles, leaving out default values.",
          "type": "object",
          "propertyNames": {
            "enum": [
              "display",
              "position",
              "font-family",
              "font-size",
              "font-weight",
              "line-height",
              "color",
              "background-color",
              "padding",
              "margin",
              "gap",
              "border",
              "border-radius",
              "box-shadow"
            ]
          },
          "additionalProperties": {
            "type": "string",
            "minLength": 1
          }
        },
        "rules": {
          "description": "Matching CSS rules, later ones last.",
          "type": "array",
          "maxItems": 10,
          "items": {
            "$ref": "#/$defs/rule"
          }
        },
        "nearby": {
          "description": "Visible text near the element.",
          "type": "array",
          "maxItems": 5,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "html": {
          "description": "Its outer HTML, trimmed.",
          "type": "string",
          "maxLength": 1600
        }
      },
      "required": [
        "label",
        "selector"
      ],
      "additionalProperties": false
    },
    "viewport": {
      "description": "The page's viewport once per tweak, in CSS pixels, and the device pixel ratio.",
      "type": "object",
      "properties": {
        "width": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "height": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "dpr": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      },
      "required": [
        "width",
        "height",
        "dpr"
      ],
      "additionalProperties": false
    },
    "location": {
      "description": "A source location (docs/design.md, Finding the source). file is as the page gave it: absolute, project-relative or a dev-server URL; the bridge places it in the project.",
      "type": "object",
      "properties": {
        "file": {
          "type": "string",
          "minLength": 1
        },
        "line": {
          "type": "integer",
          "minimum": 1
        },
        "column": {
          "type": "integer",
          "minimum": 1
        },
        "role": {
          "enum": [
            "element",
            "component",
            "usage",
            "style"
          ]
        },
        "via": {
          "enum": [
            "react",
            "vue",
            "svelte",
            "rails",
            "proscenium",
            "css"
          ]
        },
        "name": {
          "description": "The component's name, where the mapper knows it.",
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "file",
        "role",
        "via"
      ],
      "additionalProperties": false
    },
    "clue": {
      "description": "Something to search the project for.",
      "type": "object",
      "properties": {
        "kind": {
          "enum": [
            "data-testid",
            "data-test",
            "data-qa",
            "data-cy",
            "id",
            "aria-label",
            "placeholder",
            "title",
            "alt",
            "text",
            "class",
            "href"
          ]
        },
        "value": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "kind",
        "value"
      ],
      "additionalProperties": false
    },
    "size": {
      "description": "The element's box in CSS pixels.",
      "type": "object",
      "properties": {
        "width": {
          "type": "number",
          "minimum": 0
        },
        "height": {
          "type": "number",
          "minimum": 0
        }
      },
      "required": [
        "width",
        "height"
      ],
      "additionalProperties": false
    },
    "rule": {
      "description": "A CSS rule matching the element: its selector, the sheet's file where known (a <style data-vite-dev-id> or the sheet's href), and a line where a source map gives one.",
      "type": "object",
      "properties": {
        "selector": {
          "type": "string",
          "minLength": 1
        },
        "file": {
          "type": "string",
          "minLength": 1
        },
        "line": {
          "type": "integer",
          "minimum": 1
        },
        "column": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "selector"
      ],
      "additionalProperties": false
    },
    "change": {
      "description": "What the tweak changed, as its card lists it (docs/design.md, \"On the card\"): paths only, never contents. Absent until undo capture has ended for the tweak once, and while it is capturing.",
      "type": "object",
      "properties": {
        "state": {
          "enum": [
            "recorded",
            "nothing-recorded",
            "undo-requested",
            "undone"
          ]
        },
        "checked": {
          "description": "The git check ran when capture last ended: with no files and nothing unrecorded, no files changed.",
          "type": "boolean"
        },
        "files": {
          "description": "The recorded files, oldest first.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/changedFile"
          }
        },
        "unrecorded": {
          "description": "Files that changed while Claude worked without being recorded: Undo never touches them.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/changedFile"
          }
        }
      },
      "required": [
        "state",
        "checked",
        "files",
        "unrecorded"
      ],
      "additionalProperties": false
    },
    "changedFile": {
      "type": "object",
      "properties": {
        "path": {
          "description": "Relative to the session folder (with /), or absolute when outside it.",
          "type": "string",
          "minLength": 1
        },
        "outside": {
          "description": "Outside the session folder: the card labels it \"outside this project\".",
          "type": "boolean"
        }
      },
      "required": [
        "path",
        "outside"
      ],
      "additionalProperties": false
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "event": {
            "enum": [
              "claim-made",
              "claim-released"
            ]
          }
        }
      },
      "then": {
        "required": [
          "claim"
        ],
        "properties": {
          "claim": true,
          "tweak": false
        }
      }
    },
    {
      "if": {
        "properties": {
          "event": {
            "enum": [
              "tweak-created",
              "tweak-status",
              "tweak-replied",
              "tweak-again"
            ]
          }
        }
      },
      "then": {
        "required": [
          "tweak"
        ],
        "properties": {
          "tweak": true,
          "claim": false
        }
      }
    }
  ]
}
