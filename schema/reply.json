{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/codaset/tweak/schema/reply.json",
  "title": "reply",
  "description": "To the bridge on the WebSocket: the developer's answer to Claude's question, from the card. Answered by a result with the tweak's number; the tweak-replied event follows.",
  "type": "object",
  "properties": {
    "type": {
      "const": "reply"
    },
    "ref": {
      "type": "string",
      "minLength": 1
    },
    "number": {
      "type": "integer",
      "minimum": 1
    },
    "text": {
      "type": "string",
      "pattern": "\\S"
    }
  },
  "required": [
    "type",
    "ref",
    "number",
    "text"
  ],
  "additionalProperties": false
}
