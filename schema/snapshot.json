{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/codaset/tweak/schema/snapshot.json",
  "title": "snapshot",
  "description": "The bridge's answer to hello on the WebSocket: the current state, as of event seq. The worker rebuilds from it; events with a higher seq follow.",
  "type": "object",
  "properties": {
    "type": {
      "const": "snapshot"
    },
    "seq": {
      "description": "The last event the snapshot includes; 0 before any event.",
      "type": "integer",
      "minimum": 0
    },
    "version": {
      "description": "The version of the extension the bridge wrote to its extension folder (X.Y.Z). The worker reloads itself when its own differs. A development bridge (TWEAK_BIN) sends none.",
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "claims": {
      "description": "Every claim, oldest first.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/claim"
      }
    }
  },
  "required": [
    "type",
    "seq",
    "claims"
  ],
  "additionalProperties": false,
  "$defs": {
    "claim": {
      "description": "A claim: a session's ownership of the pages matching a pattern.",
      "type": "object",
      "properties": {
        "id": {
          "type": "integer",
          "minimum": 1
        },
        "pattern": {
          "description": "The normalised Chrome match pattern, as the extension registers it.",
          "type": "string",
          "minLength": 1
        },
        "session": {
          "$ref": "#/$defs/session"
        },
        "created": {
          "type": "string",
          "description": "RFC 3339",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T"
        }
      },
      "required": [
        "id",
        "pattern",
        "session",
        "created"
      ],
      "additionalProperties": false
    },
    "session": {
      "description": "A session: one agent conversation.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "agent": {
          "type": "string",
          "minLength": 1
        },
        "folder": {
          "type": "string",
          "minLength": 1
        },
        "label": {
          "type": "string"
        },
        "lastCheckIn": {
          "type": "string",
          "description": "RFC 3339",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T"
        }
      },
      "required": [
        "id",
        "agent",
        "folder",
        "label",
        "lastCheckIn"
      ],
      "additionalProperties": false
    }
  }
}
