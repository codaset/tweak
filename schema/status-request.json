{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/codaset/tweak/schema/status-request.json",
  "title": "status-request",
  "description": "POST /tweaks/:n/status from the CLI. Only done so far; ask, decline and queue come with the conversation.",
  "type": "object",
  "properties": {
    "status": {
      "enum": [
        "done"
      ]
    },
    "message": {
      "description": "done: Claude's summary.",
      "type": "string",
      "pattern": "\\S"
    }
  },
  "required": [
    "status",
    "message"
  ],
  "additionalProperties": false
}
